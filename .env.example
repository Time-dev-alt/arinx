# Copy to .env.local for local development. NEVER commit real secret keys.
# Lovable Cloud injects these at runtime; only publishable (public) keys are
# safe to expose to the browser.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional platform flags (all default off / safe):
# ARINX_DEMO_DATA=1                  # local-only seed content for previews
# ARINX_CSP_REPORT_ONLY=1           # downgrade CSP enforcement to baseline
# ARINX_CROSS_ORIGIN_ISOLATION=1    # enable multithreaded ffmpeg on /studio/upload

# Server-only, supplied by the platform — never prefix these with VITE_:
# SUPABASE_SERVICE_ROLE_KEY=...     # managed by Lovable Cloud; not in the repo
# LOVABLE_CRON_SECRET=...           # managed by Lovable Cloud; not in the repo
