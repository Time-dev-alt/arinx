# Cloudflare static assets bypass the SSR worker. Keep these headers in sync
# with src/lib/security-headers.server.ts (asserted by src/test/source-invariants.test.ts).
# No nonce here: static files are not documents, and the nonce is generated per
# response by the worker. Scripts are still strictly limited to 'self'/HTTPS.
/*
  Content-Security-Policy: default-src 'self' https: blob: data:; script-src 'self' https: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss: blob: data:; worker-src 'self' blob:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https:; report-uri /csp-report
  Content-Security-Policy-Report-Only: default-src 'self' https: blob: data:; script-src 'self' https: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss: blob: data:; worker-src 'self' blob:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://*.lovable.dev https://lovable.dev https://*.lovable.app https://*.e2b.app http://localhost:* http://127.0.0.1:*; require-trusted-types-for 'script'; report-uri /csp-report
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=()
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off
  Cross-Origin-Resource-Policy: cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Cache-Control: public, max-age=3600
